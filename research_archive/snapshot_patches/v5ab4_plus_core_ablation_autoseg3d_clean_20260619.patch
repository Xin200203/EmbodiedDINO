diff --git a/scripts/codex_tools/build_mv_dino_manifest.py b/scripts/codex_tools/build_mv_dino_manifest.py
new file mode 100755
index 0000000..04966c4
--- /dev/null
+++ b/scripts/codex_tools/build_mv_dino_manifest.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Build a DINO cache manifest from ScanNet MV pkl img_paths only.
+
+This script intentionally does not scan raw 2D directories. It only records
+frames referenced by the MV info pkl files, so the offline cache is aligned
+with the actual ESAM/AutoSeg3D MV protocol.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import pickle
+from pathlib import Path
+from typing import Dict, List
+
+
+def sha256_file(path: Path, chunk_size: int = 1 << 20) -> str:
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        while True:
+            b = f.read(chunk_size)
+            if not b:
+                break
+            h.update(b)
+    return h.hexdigest()
+
+
+def load_data_list(pkl_path: Path) -> List[dict]:
+    with pkl_path.open('rb') as f:
+        obj = pickle.load(f)
+    if isinstance(obj, dict) and 'data_list' in obj:
+        return obj['data_list']
+    if isinstance(obj, list):
+        return obj
+    raise TypeError(f'Unsupported pkl format: {pkl_path}, type={type(obj)}')
+
+
+def cache_rel_for_img(rel_img: str, suffix: str = '.pt') -> str:
+    p = Path(rel_img)
+    return str(p.with_suffix(suffix))
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--data-root', default='data/scannet200-mv_fast')
+    ap.add_argument('--train-pkl', default='data/scannet200-mv_fast/scannet200_mv_oneformer3d_infos_train.pkl')
+    ap.add_argument('--val-pkl', default='data/scannet200-mv_fast/scannet200_mv_oneformer3d_infos_val.pkl')
+    ap.add_argument('--cache-root', required=True)
+    ap.add_argument('--out-dir', required=True)
+    ap.add_argument('--subset-size', type=int, default=128)
+    ap.add_argument('--seed', type=int, default=2050318485)
+    args = ap.parse_args()
+
+    data_root = Path(args.data_root)
+    cache_root = Path(args.cache_root)
+    out_dir = Path(args.out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    records: Dict[str, dict] = {}
+    split_counts = {}
+    pkl_info = {}
+    for split, pkl in [('train', Path(args.train_pkl)), ('val', Path(args.val_pkl))]:
+        dl = load_data_list(pkl)
+        pkl_info[split] = {
+            'path': str(pkl),
+            'sha256': sha256_file(pkl),
+            'num_scenes': len(dl),
+        }
+        n_refs = 0
+        for scene_idx, item in enumerate(dl):
+            for frame_idx, rel in enumerate(item.get('img_paths', []) or []):
+                n_refs += 1
+                rel = str(rel)
+                abs_img = data_root / rel
+                rec = records.setdefault(rel, {
+                    'rel_img_path': rel,
+                    'abs_img_path': str(abs_img),
+                    'cache_rel_path': cache_rel_for_img(rel),
+                    'cache_path': str(cache_root / cache_rel_for_img(rel)),
+                    'splits': [],
+                    'refs': [],
+                    'exists': abs_img.exists(),
+                })
+                if split not in rec['splits']:
+                    rec['splits'].append(split)
+                if len(rec['refs']) < 8:
+                    rec['refs'].append({'split': split, 'scene_idx': scene_idx, 'frame_idx': frame_idx})
+        split_counts[split] = {'num_scenes': len(dl), 'num_frame_refs': n_refs}
+
+    all_recs = [records[k] for k in sorted(records)]
+    missing = [r for r in all_recs if not r['exists']]
+    manifest = out_dir / 'scannet200_mv_fast_dino_used_frames_manifest.jsonl'
+    with manifest.open('w') as f:
+        for r in all_recs:
+            f.write(json.dumps(r, ensure_ascii=False) + '\n')
+
+    import random
+    rng = random.Random(args.seed)
+    subset = list(all_recs)
+    rng.shuffle(subset)
+    subset = subset[: min(args.subset_size, len(subset))]
+    subset_path = out_dir / f'scannet200_mv_fast_dino_used_frames_subset{len(subset)}_seed{args.seed}.jsonl'
+    with subset_path.open('w') as f:
+        for r in subset:
+            f.write(json.dumps(r, ensure_ascii=False) + '\n')
+
+    summary = {
+        'data_root': str(data_root),
+        'cache_root': str(cache_root),
+        'manifest': str(manifest),
+        'subset_manifest': str(subset_path),
+        'seed': args.seed,
+        'pkl_info': pkl_info,
+        'split_counts': split_counts,
+        'unique_frames': len(all_recs),
+        'missing_images': len(missing),
+        'missing_examples': missing[:10],
+    }
+    summary_path = out_dir / 'scannet200_mv_fast_dino_used_frames_summary.json'
+    summary_path.write_text(json.dumps(summary, indent=2, ensure_ascii=False))
+    print(json.dumps(summary, indent=2, ensure_ascii=False))
+    if missing:
+        raise SystemExit(f'{len(missing)} images referenced by pkl are missing')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/codex_tools/compact_dino_cache.py b/scripts/codex_tools/compact_dino_cache.py
new file mode 100644
index 0000000..68041b8
--- /dev/null
+++ b/scripts/codex_tools/compact_dino_cache.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Compact DINO cache files accidentally saved from batch-view tensors.
+
+When a per-frame feature is a view into a batch tensor, torch.save stores the
+whole underlying batch storage. This script rewrites each payload with
+payload['feat'].contiguous().clone() so the file stores only one feature map.
+"""
+from __future__ import annotations
+import argparse
+import json
+import os
+import time
+from concurrent.futures import ProcessPoolExecutor, as_completed
+from pathlib import Path
+
+import torch
+
+
+def compact_one(path_str: str, max_expected_mb: float, dry_run: bool = False):
+    path = Path(path_str)
+    before = path.stat().st_size
+    if before <= max_expected_mb * 1024 * 1024:
+        return {'path': str(path), 'status': 'skip_small', 'before': before, 'after': before}
+    try:
+        payload = torch.load(path, map_location='cpu')
+        if isinstance(payload, dict) and torch.is_tensor(payload.get('feat')):
+            payload['feat'] = payload['feat'].contiguous().clone()
+        elif torch.is_tensor(payload):
+            payload = payload.contiguous().clone()
+        else:
+            return {'path': str(path), 'status': 'skip_unknown_payload', 'before': before, 'after': before}
+        if dry_run:
+            return {'path': str(path), 'status': 'dry_run', 'before': before, 'after': before}
+        tmp = path.with_suffix(path.suffix + '.compact_tmp')
+        torch.save(payload, tmp)
+        tmp.replace(path)
+        after = path.stat().st_size
+        return {'path': str(path), 'status': 'compacted', 'before': before, 'after': after}
+    except Exception as exc:
+        return {'path': str(path), 'status': 'failed', 'before': before, 'after': before, 'error': repr(exc)}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--cache-root', required=True)
+    ap.add_argument('--summary', required=True)
+    ap.add_argument('--workers', type=int, default=8)
+    ap.add_argument('--max-expected-mb', type=float, default=6.0)
+    ap.add_argument('--dry-run', action='store_true')
+    args = ap.parse_args()
+
+    root = Path(args.cache_root)
+    files = [str(p) for p in root.rglob('*.pt')]
+    t0 = time.time()
+    status_counts = {}
+    before_total = 0
+    after_total = 0
+    failures = []
+    n = len(files)
+    with ProcessPoolExecutor(max_workers=args.workers) as ex:
+        futs = [ex.submit(compact_one, p, args.max_expected_mb, args.dry_run) for p in files]
+        for i, fut in enumerate(as_completed(futs), 1):
+            res = fut.result()
+            status_counts[res['status']] = status_counts.get(res['status'], 0) + 1
+            before_total += int(res.get('before', 0))
+            after_total += int(res.get('after', 0))
+            if res['status'] == 'failed':
+                failures.append(res)
+            if i % 500 == 0 or i == n:
+                print(json.dumps({'progress': [i, n], 'status_counts': status_counts}, ensure_ascii=False), flush=True)
+    summary = {
+        'cache_root': str(root),
+        'num_files': n,
+        'workers': args.workers,
+        'status_counts': status_counts,
+        'before_bytes_sum_seen': before_total,
+        'after_bytes_sum_seen': after_total,
+        'saved_bytes_sum_seen': before_total - after_total,
+        'elapsed_sec': round(time.time() - t0, 3),
+        'failures': failures[:50],
+    }
+    Path(args.summary).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.summary).write_text(json.dumps(summary, indent=2, ensure_ascii=False))
+    print(json.dumps(summary, indent=2, ensure_ascii=False), flush=True)
+    if failures:
+        raise SystemExit(f'{len(failures)} compaction failures')
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/codex_tools/extract_mv_dino_cache.py b/scripts/codex_tools/extract_mv_dino_cache.py
new file mode 100755
index 0000000..e257814
--- /dev/null
+++ b/scripts/codex_tools/extract_mv_dino_cache.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Extract offline DINOv2 feature maps for a JSONL manifest.
+
+The cache unit is an RGB frame feature map after deterministic resize to
+420x560. Output tensor shape is Cx30x40 for ViT-L/14. Projection to 3D remains
+online during training/smoke, so cache is independent of point sampling.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import time
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+from typing import List, Tuple
+
+import torch
+import torchvision.transforms as T
+from PIL import Image
+from tqdm import tqdm
+
+from tools.extract_dinov2_features import DINOv2FeatureExtractor
+
+DINO_MEAN = (0.485, 0.456, 0.406)
+DINO_STD = (0.229, 0.224, 0.225)
+PATCH_SIZE = 14
+
+
+def load_jsonl(path: Path) -> List[dict]:
+    out = []
+    with path.open() as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                out.append(json.loads(line))
+    return out
+
+
+def preprocess(path: Path, target_hw: Tuple[int, int]) -> Tuple[torch.Tensor, Tuple[int, int]]:
+    img = Image.open(path).convert('RGB')
+    src_wh = img.size
+    h, w = target_hw
+    img = img.resize((w, h), Image.BILINEAR)
+    x = T.ToTensor()(img)
+    x = T.Normalize(DINO_MEAN, DINO_STD)(x)
+    return x, (src_wh[1], src_wh[0])
+
+
+@torch.inference_mode()
+def forward_batch(model, imgs: torch.Tensor) -> torch.Tensor:
+    weight_dtype = model.patch_embed.proj.weight.dtype
+    imgs = imgs.to(device=next(model.parameters()).device, dtype=weight_dtype)
+    feats = model.forward_features(imgs)
+    if isinstance(feats, dict):
+        tokens = feats.get('x_norm_patchtokens', None)
+        h = feats.get('h', None)
+        w = feats.get('w', None)
+        if isinstance(h, torch.Tensor):
+            h = int(h.item())
+        if isinstance(w, torch.Tensor):
+            w = int(w.item())
+    else:
+        tokens, h, w = feats, None, None
+    if tokens is None:
+        raise RuntimeError('DINO forward_features did not return patch tokens')
+    b, l, c = tokens.shape
+    if h is None or w is None:
+        h = imgs.shape[-2] // PATCH_SIZE
+        w = imgs.shape[-1] // PATCH_SIZE
+    if h * w > l:
+        raise RuntimeError(f'Invalid DINO grid h*w={h*w} > tokens={l}')
+    return tokens[:, :h*w, :].transpose(1, 2).reshape(b, c, h, w).contiguous()
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--manifest', required=True)
+    ap.add_argument('--cache-root', required=True)
+    ap.add_argument('--checkpoint', default='/datadisk1/xxy/data/models/dinov2_vitl14_reg4_pretrain.pth')
+    ap.add_argument('--arch', default='dinov2_vitl14_reg')
+    ap.add_argument('--device', default='cuda:0')
+    ap.add_argument('--batch-size', type=int, default=8)
+    ap.add_argument('--target-h', type=int, default=420)
+    ap.add_argument('--target-w', type=int, default=560)
+    ap.add_argument('--dtype', choices=['fp16', 'fp32'], default='fp16')
+    ap.add_argument('--limit', type=int, default=0)
+    ap.add_argument('--shard-index', type=int, default=0)
+    ap.add_argument('--num-shards', type=int, default=1)
+    ap.add_argument('--overwrite', action='store_true')
+    ap.add_argument('--summary', required=True)
+    args = ap.parse_args()
+
+    if args.device.startswith('cuda:'):
+        os.environ.setdefault('CUDA_VISIBLE_DEVICES', args.device.split(':')[-1])
+        device = 'cuda:0'
+    else:
+        device = args.device
+    manifest = Path(args.manifest)
+    cache_root = Path(args.cache_root)
+    cache_root.mkdir(parents=True, exist_ok=True)
+    recs = load_jsonl(manifest)
+    recs = [r for i, r in enumerate(recs) if i % args.num_shards == args.shard_index]
+    if args.limit > 0:
+        recs = recs[:args.limit]
+
+    dtype = torch.float16 if args.dtype == 'fp16' else torch.float32
+    extractor = DINOv2FeatureExtractor(arch=args.arch, device=device, dtype=dtype, checkpoint=args.checkpoint)
+    model = extractor.model.eval()
+
+    done = skipped = failed = 0
+    shapes = {}
+    t0 = time.time()
+    batch_imgs, batch_recs, batch_src = [], [], []
+
+    def flush():
+        nonlocal done, batch_imgs, batch_recs, batch_src
+        if not batch_imgs:
+            return
+        imgs = torch.stack(batch_imgs, dim=0)
+        feats = forward_batch(model, imgs)
+        feats = feats.half().cpu() if dtype == torch.float16 else feats.float().cpu()
+        for feat, rec, src_hw in zip(feats, batch_recs, batch_src):
+            # IMPORTANT: feat is a slice/view into the batch tensor. Saving a view with
+            # torch.save serializes the whole underlying batch storage (~8x larger for
+            # batch_size=8). Clone to compact standalone storage before caching.
+            feat = feat.contiguous().clone()
+            out = cache_root / rec['cache_rel_path']
+            out.parent.mkdir(parents=True, exist_ok=True)
+            payload = {
+                'feat': feat,
+                'rel_img_path': rec['rel_img_path'],
+                'src_hw': src_hw,
+                'target_hw': [args.target_h, args.target_w],
+                'arch': args.arch,
+                'checkpoint': args.checkpoint,
+                'dtype': args.dtype,
+            }
+            tmp_out = out.with_suffix(out.suffix + '.tmp')
+            torch.save(payload, tmp_out)
+            tmp_out.replace(out)
+            shapes[str(tuple(feat.shape))] = shapes.get(str(tuple(feat.shape)), 0) + 1
+            done += 1
+        batch_imgs, batch_recs, batch_src = [], [], []
+
+    for rec in tqdm(recs, desc=f'shard {args.shard_index}/{args.num_shards}'):
+        out = cache_root / rec['cache_rel_path']
+        if out.exists() and not args.overwrite:
+            skipped += 1
+            continue
+        try:
+            x, src_hw = preprocess(Path(rec['abs_img_path']), (args.target_h, args.target_w))
+            batch_imgs.append(x)
+            batch_recs.append(rec)
+            batch_src.append(src_hw)
+            if len(batch_imgs) >= args.batch_size:
+                flush()
+        except Exception as e:
+            failed += 1
+            print(json.dumps({'failed': rec, 'error': repr(e)}, ensure_ascii=False), flush=True)
+    flush()
+    summary = {
+        'manifest': str(manifest),
+        'cache_root': str(cache_root),
+        'checkpoint': args.checkpoint,
+        'arch': args.arch,
+        'device': args.device,
+        'batch_size': args.batch_size,
+        'target_hw': [args.target_h, args.target_w],
+        'dtype': args.dtype,
+        'num_input_records_after_shard_limit': len(recs),
+        'num_done': done,
+        'num_skipped': skipped,
+        'num_failed': failed,
+        'shape_counts': shapes,
+        'elapsed_sec': round(time.time() - t0, 3),
+    }
+    Path(args.summary).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.summary).write_text(json.dumps(summary, indent=2, ensure_ascii=False))
+    print(json.dumps(summary, indent=2, ensure_ascii=False))
+    if failed:
+        raise SystemExit(f'{failed} extraction failures')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/codex_tools/smoke_mv_dino_projection.py b/scripts/codex_tools/smoke_mv_dino_projection.py
new file mode 100755
index 0000000..ea91d29
--- /dev/null
+++ b/scripts/codex_tools/smoke_mv_dino_projection.py
@@ -0,0 +1,240 @@
+#!/usr/bin/env python3
+"""Standalone projection smoke for offline DINO cache.
+
+It validates the protocol-critical part before full training: MV pkl img_paths
+map to cache files, 2D feature maps have expected shape, and points project into
+feature-grid coordinates with high valid ratio under the same pose convention
+used by v5 (`inv`, with optional auto comparison).
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import pickle
+from pathlib import Path
+from typing import Any, Dict, List, Tuple
+
+import numpy as np
+import torch
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+import sys
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+import importlib.util
+_proj_path = REPO_ROOT / "oneformer3d" / "projection_utils.py"
+_spec = importlib.util.spec_from_file_location("codex_projection_utils", _proj_path)
+_projection_utils = importlib.util.module_from_spec(_spec)
+assert _spec and _spec.loader
+_spec.loader.exec_module(_projection_utils)
+project_points_to_uv = _projection_utils.project_points_to_uv
+sample_img_feat = _projection_utils.sample_img_feat
+
+SCANNT_INTR = (577.870605, 577.870605, 319.5, 239.5)
+
+
+def load_data_list(path: Path) -> List[dict]:
+    with path.open('rb') as f:
+        obj = pickle.load(f)
+    if isinstance(obj, dict) and 'data_list' in obj:
+        return obj['data_list']
+    if isinstance(obj, list):
+        return obj
+    raise TypeError(type(obj))
+
+
+def read_bin(path: Path, dtype, cols: int) -> np.ndarray:
+    arr = np.fromfile(path, dtype=dtype)
+    if arr.size % cols != 0:
+        raise RuntimeError(f'{path} size {arr.size} not divisible by {cols}')
+    return arr.reshape(-1, cols)
+
+
+def load_points(data_root: Path, item: dict, frame_idx: int) -> torch.Tensor:
+    pts_paths = item.get('pts_paths') or item.get('point_cloud', {}).get('pts_paths')
+    if pts_paths is None:
+        raise KeyError('pts_paths')
+    rel = pts_paths[frame_idx]
+    path = data_root / rel
+    # ESAM/AutoSeg ScanNet pkl stores float32 points with xyzrgb-like features.
+    raw = np.fromfile(path, dtype=np.float32)
+    for cols in (6, 9, 12, 3):
+        if raw.size % cols == 0:
+            arr = raw.reshape(-1, cols)
+            if arr.shape[1] >= 3:
+                return torch.from_numpy(arr[:, :3].copy()).float()
+    raise RuntimeError(f'cannot infer point columns for {path}, raw_size={raw.size}')
+
+
+def parse_cache(cache_path: Path) -> torch.Tensor:
+    payload = torch.load(cache_path, map_location='cpu')
+    feat = payload['feat'] if isinstance(payload, dict) and 'feat' in payload else payload
+    if not torch.is_tensor(feat):
+        raise TypeError(f'cache {cache_path} does not contain tensor feat')
+    if tuple(feat.shape[-2:]) != (30, 40) or feat.shape[0] != 1024:
+        raise RuntimeError(f'unexpected feature shape {tuple(feat.shape)} for {cache_path}')
+    return feat.float().unsqueeze(0)
+
+
+def project_one(points: torch.Tensor, pose: Any, feat: torch.Tensor, mode: str) -> Tuple[float, int, int, str]:
+    device = feat.device
+    xyz_world = points.to(device)
+    pose_t = torch.as_tensor(pose, device=device, dtype=xyz_world.dtype)
+    candidates = []
+    if mode in ('inv', 'auto'):
+        candidates.append(('inv', torch.linalg.inv(pose_t)))
+    if mode in ('direct', 'auto'):
+        candidates.append(('direct', pose_t))
+    if mode in ('identity', 'auto'):
+        candidates.append(('identity', None))
+    best = None
+    H_feat, W_feat = feat.shape[-2:]
+    # Match BuildCamInfoFromPoses + ResizeForDINO: ScanNet intrinsics are
+    # first scaled from original 640x480 image to target 560x420, then mapped
+    # to DINO patch grid.
+    H0, W0 = 480.0, 640.0
+    H_img, W_img = 420.0, 560.0
+    fx0, fy0, cx0, cy0 = SCANNT_INTR
+    fx = fx0 * (W_img / W0)
+    fy = fy0 * (H_img / H0)
+    cx = cx0 * (W_img / W0)
+    cy = cy0 * (H_img / H0)
+    scale_w, scale_h = W_feat / W_img, H_feat / H_img
+    intr_feat = (fx * scale_w, fy * scale_h, (cx + 0.5) * scale_w - 0.5, (cy + 0.5) * scale_h - 0.5)
+    ones = torch.ones((xyz_world.shape[0], 1), device=device, dtype=xyz_world.dtype)
+    xyz_h = torch.cat([xyz_world, ones], dim=1)
+    for name, T in candidates:
+        xyz_cam = xyz_world if T is None else (xyz_h @ T.t())[:, :3]
+        uv, valid = project_points_to_uv(
+            xyz_cam,
+            feat_hw=(H_feat, W_feat),
+            max_depth=20.0,
+            standard_intrinsics=intr_feat,
+            already_scaled=True,
+        )
+        cnt = int(valid.sum().item())
+        total = int(valid.numel())
+        rate = cnt / max(total, 1)
+        if best is None or rate > best[0]:
+            best = (rate, cnt, total, name, uv, valid)
+    assert best is not None
+    # Also sample once to catch grid_sample / coordinate errors.
+    _ = sample_img_feat(feat, best[4], best[5], align_corners=False)
+    return float(best[0]), int(best[1]), int(best[2]), str(best[3])
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--pkl', default='data/scannet200-mv_fast/scannet200_mv_oneformer3d_infos_train.pkl')
+    ap.add_argument('--data-root', default='data/scannet200-mv_fast')
+    ap.add_argument('--cache-root', required=True)
+    ap.add_argument('--manifest', required=True)
+    ap.add_argument('--num-scenes', type=int, default=8)
+    ap.add_argument('--frames-per-scene', type=int, default=4)
+    ap.add_argument('--pose-mode', choices=['inv', 'direct', 'identity', 'auto'], default='auto')
+    ap.add_argument('--summary', required=True)
+    args = ap.parse_args()
+
+    data_root = Path(args.data_root)
+    cache_root = Path(args.cache_root)
+    manifest_rels = []
+    with Path(args.manifest).open() as f:
+        for line in f:
+            if line.strip():
+                manifest_rels.append(json.loads(line)['rel_img_path'])
+    manifest_set = set(manifest_rels)
+    dl = load_data_list(Path(args.pkl))
+    rows = []
+    total_valid = 0
+    total_points = 0
+    pose_counts: Dict[str, int] = {}
+    checked = 0
+
+    # Prefer exact scene/frame references stored in the manifest. This lets a
+    # random subset cache smoke validate only frames that were actually cached.
+    target_pairs = []
+    manifest_records = []
+    with Path(args.manifest).open() as f:
+        for line in f:
+            if line.strip():
+                manifest_records.append(json.loads(line))
+    for rec in manifest_records:
+        cache_path = cache_root / rec['cache_rel_path']
+        if not cache_path.exists():
+            continue
+        refs = rec.get('refs') or []
+        chosen_ref = None
+        for ref in refs:
+            if ref.get('split') == 'train':
+                chosen_ref = ref
+                break
+        # This smoke loads the train pkl; skip val-only cached frames here.
+        if chosen_ref is not None:
+            target_pairs.append((int(chosen_ref['scene_idx']), int(chosen_ref['frame_idx']), rec['rel_img_path']))
+    if not target_pairs:
+        # Fallback: deterministic first scenes, useful only after a full cache exists.
+        for scene_idx, item in enumerate(dl[:args.num_scenes]):
+            img_paths = item['img_paths']
+            if not img_paths:
+                continue
+            idxs = np.linspace(0, len(img_paths) - 1, num=min(args.frames_per_scene, len(img_paths)), dtype=int).tolist()
+            for frame_idx in idxs:
+                target_pairs.append((scene_idx, int(frame_idx), img_paths[int(frame_idx)]))
+    max_checks = args.num_scenes * args.frames_per_scene
+    target_pairs = target_pairs[:max_checks]
+
+    for scene_idx, frame_idx, rel in target_pairs:
+        item = dl[scene_idx]
+        poses = item['poses']
+        if rel not in manifest_set:
+            raise RuntimeError(f'{rel} absent from manifest')
+        cache_path = cache_root / Path(rel).with_suffix('.pt')
+        if not cache_path.exists():
+            rows.append({'scene_idx': scene_idx, 'frame_idx': frame_idx, 'rel_img_path': rel, 'status': 'missing_cache'})
+            continue
+        feat = parse_cache(cache_path)
+        points = load_points(data_root, item, frame_idx)
+        rate, cnt, total, chosen = project_one(points, poses[frame_idx], feat, args.pose_mode)
+        total_valid += cnt
+        total_points += total
+        pose_counts[chosen] = pose_counts.get(chosen, 0) + 1
+        checked += 1
+        rows.append({
+            'scene_idx': scene_idx,
+            'frame_idx': frame_idx,
+            'rel_img_path': rel,
+            'cache_path': str(cache_path),
+            'valid_rate': rate,
+            'valid_count': cnt,
+            'total_points': total,
+            'pose_mode': chosen,
+            'feature_shape': list(feat.shape),
+            'status': 'ok',
+        })
+    rates = [r['valid_rate'] for r in rows if r.get('status') == 'ok']
+    summary = {
+        'pkl': args.pkl,
+        'data_root': args.data_root,
+        'cache_root': str(cache_root),
+        'manifest': args.manifest,
+        'num_checked': checked,
+        'num_missing_cache': sum(1 for r in rows if r.get('status') == 'missing_cache'),
+        'mean_valid_rate': (sum(rates) / len(rates)) if rates else None,
+        'min_valid_rate': min(rates) if rates else None,
+        'max_valid_rate': max(rates) if rates else None,
+        'global_valid_rate': (total_valid / total_points) if total_points else None,
+        'pose_mode_counts': pose_counts,
+        'rows': rows,
+    }
+    Path(args.summary).parent.mkdir(parents=True, exist_ok=True)
+    Path(args.summary).write_text(json.dumps(summary, indent=2, ensure_ascii=False))
+    print(json.dumps(summary, indent=2, ensure_ascii=False))
+    if checked == 0:
+        raise SystemExit('no cached frames checked')
+    if summary['min_valid_rate'] is not None and summary['min_valid_rate'] < 0.90:
+        raise SystemExit(f"projection valid rate below 0.90: min={summary['min_valid_rate']}")
+
+
+if __name__ == '__main__':
+    main()
