+@TRANSFORMS.register_module()
+class LoadDINOFeatureFromCache(BaseTransform):
+    """Load pre-extracted DINO feature maps for the MV frames selected by LoadAdjacentDataFromFile."""
+    def __init__(self,
+                 cache_root: str,
