+            inserted = True
+            break
+    if not inserted:
+        raise RuntimeError('LoadAdjacentDataFromFile not found in pipeline')
+    for step in pipeline:
+        if step.get('type') == 'Pack3DDetInputs_Online':
+            keys = list(step.get('keys', []))
+            for k in ['img_paths', 'dino_feat_maps', 'cam_info', 'dino_cache_paths']:
+                if k not in keys:
+                    keys.append(k)
+            step['keys'] = keys
+    return pipeline
